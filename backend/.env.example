SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PUBLISHABLE_KEY=
# Enable after applying sql/004_google_auth.sql and enabling Google in Supabase Auth.
AUTH_ENABLED=false
# Base64-encoded random 32-byte key. See docs/GOOGLE_AUTH.md; keep stable across restarts.
AUTH_ENCRYPTION_KEY=
AUTH_CALLBACK_URL=http://localhost:4000/api/auth/callback
AUTH_FRONTEND_URL=http://localhost:5173
# Required for HTTPS deployments. Use the same site for frontend and API.
AUTH_COOKIE_SECURE=false
AUTH_SESSION_DAYS=7
MAPBOX_SECRET_TOKEN=
# Server-only key with Routes API enabled (do not use the browser-restricted key).
GOOGLE_ROUTES_API_KEY=
# Optional local OSM/Overpass JSON road extract for the WayDine route preview.
OSM_GRAPH_PATH=
# overpass fetches road data for the requested trip on demand; file uses the local extract.
OSM_GRAPH_SOURCE=file
# graph: stops are ranked by WayDine's own Dijkstra over OSM data (Google supplies only the baseline route
# and an optional cross-check). google: Google Routes does all routing. Falls back to google if the graph fails.
ROUTING_ENGINE=google
# With OSM_GRAPH_SOURCE=overpass, downloaded corridors are cached here and reused.
GRAPH_CACHE_DIR=.data/osm-cache
# How many top graph results are re-checked with Google Routes (0 disables; each costs one route request).
GRAPH_CROSSCHECK_TOP=3
GOOGLE_ROUTES_PER_DAY=100
GOOGLE_ROUTE_MATRIX_ELEMENTS_PER_DAY=300
GOOGLE_PLACES_API_KEY=
# Key presence alone never enables live Google requests. Obtain approval before live testing.
GOOGLE_PLACES_ENABLED=false
GOOGLE_PLACES_NEARBY_PER_DAY=10
GOOGLE_PLACES_DETAILS_PER_DAY=20
GOOGLE_PLACES_NEARBY_PER_MONTH=100
GOOGLE_PLACES_DETAILS_PER_MONTH=100
GOOGLE_PLACES_SEARCHES_PER_REQUEST=3
GOOGLE_PLACES_DETAILS_PER_REQUEST=3
GOOGLE_PLACES_CORRIDOR_M=200
GOOGLE_PLACES_QUOTA_FILE=.data/google-places-monthly.json
PORT=4000
CORS_ORIGIN=http://localhost:5173
