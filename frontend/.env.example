# Public Mapbox token (pk.*) for map display. Restrict it to your domains in the Mapbox dashboard.
VITE_MAPBOX_TOKEN=

# Browser key with Maps JavaScript API enabled; restrict it by HTTP referrer.
VITE_GOOGLE_MAPS_API_KEY=
# Optional. Leave empty to call the API on the same origin (Vite proxies /api to localhost:4000 in dev).
VITE_API_BASE_URL=
